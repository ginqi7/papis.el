; -*- mode: emacs-lisp; lexical-binding: t -*-

;; Eldev configuration for papis.el.
;;
;; One package, several files: without this, package-lint treats each
;; file as its own package and complains that the frontend's symbols
;; are not prefixed like the main file's.  All Package-Requires live in
;; the main file only.

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'melpa)
(eldev-use-package-archive '("etaf" . "https://etaf.top/packages/") 50)

(eldev-add-extra-dependencies '(compile test) 'etaf)

(setq eldev-project-main-file "papis.el")
